// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports   Report[]
  payments  Payment[]
  auditLogs AuditLog[]
  
  // ClarityBS 2.0 Relations
  healthProfile HealthProfile?
  habits        Habit[]
  ownedFamilies FamilyGroup[] @relation("FamilyOwner")
  familyGroups  FamilyGroup[] @relation("FamilyMembers")
}

model Report {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  originalFileUrl String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  extractedValues ExtractedValue?
  analysis       Analysis?
  dietPlan       DietPlan?
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExtractedValue {
  id             String   @id @default(uuid())
  reportId       String   @unique
  report         Report   @relation(fields: [reportId], references: [id])
  
  // Primary Blood Sugar
  hba1c          Float?
  fbs            Float?
  ppbs           Float?
  
  // Secondary Markers
  bloodPressure  String?  // e.g., "120/80"
  bmi            Float?
  cholesterol    Float?
  triglycerides  Float?
  
  // Patient Info
  age            Int?
  weight         Float?
  height         Float?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Analysis {
  id             String   @id @default(uuid())
  reportId       String   @unique
  report         Report   @relation(fields: [reportId], references: [id])
  
  overallRisk    RiskLevel
  explanation    String   @db.Text
  recommendations String  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum RiskLevel {
  NORMAL
  PREDIABETES
  DIABETES
  HIGH_RISK
}

model DietPlan {
  id             String   @id @default(uuid())
  reportId       String   @unique
  report         Report   @relation(fields: [reportId], references: [id])
  
  planType       PlanTier
  content        String   @db.Text
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum PlanTier {
  FREE
  BASIC_14_DAY
  PREMIUM_30_DAY
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  amount            Int
  currency          String  @default("INR")
  status            PaymentStatus @default(PENDING)
  planTier          PlanTier
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// PROPRIETARY DATASET COLLECTION (The "Secret Weapon")
// ------------------------------------------------------
model LabReportDataset {
  id              String   @id @default(uuid())
  labName         String?  // e.g., "Dr Lal PathLabs", "Apollo"
  originalPdfUrl  String?
  ocrRawText      String?  @db.Text
  
  // Ground truth JSON stored as JSONB
  canonicalJson   Json?    
  
  confidenceScore Float?   // 0.0 to 1.0
  isHumanVerified Boolean  @default(false)
  verifiedBy      String?  // Admin/Dietitian ID who verified it
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------
// CLARITYBS 2.0 (The Blood Sugar Operating System)
// ------------------------------------------------------

model HealthProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  
  currentHealthScore Int     @default(50) // 0-100
  targetHbA1c       Float?
  dietPreference    DietType @default(NON_VEG)
  weight            Float?
  height            Float?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum DietType {
  VEG
  NON_VEG
  JAIN
  VEGAN
}

model Habit {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String   // e.g., "Walk 30 mins"
  category    String   // e.g., "ACTIVITY", "NUTRITION"
  isActive    Boolean  @default(true)
  
  logs        HabitLog[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id])
  date        DateTime @db.Date // Store only the date part
  completed   Boolean  @default(false)
  
  @@unique([habitId, date])
}

model FamilyGroup {
  id          String   @id @default(uuid())
  name        String   // e.g., "Srikanth's Family"
  ownerId     String
  owner       User     @relation("FamilyOwner", fields: [ownerId], references: [id])
  
  members     User[]   @relation("FamilyMembers")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   // e.g., "NUTRITION", "EDUCATION"
  content     String   @db.Text
  isPublished Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

